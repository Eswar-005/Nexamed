# Nexamed Environment Variables Example

# Backend Server Configuration
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/nexamed?retryWrites=true&w=majority
JWT_SECRET=nexamed_production_secret_key_change_me_in_prod

# Frontend Configuration
VITE_API_BASE_URL=https://nexamed-backend.onrender.com
